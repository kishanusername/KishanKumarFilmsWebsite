# Gmail/SMTP notification settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com
ENQUIRY_RECIPIENT=your-gmail-address@gmail.com

# Meta WhatsApp Cloud API settings (optional, but required for automatic WhatsApp alerts)
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_NOTIFY_TO=919102077670
WHATSAPP_API_VERSION=v22.0
